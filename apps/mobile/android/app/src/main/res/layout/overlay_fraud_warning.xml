<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#E6000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/overlay_card_background">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fraud_overlay_title"
            android:textColor="#D32F2F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/overlay_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fraud_overlay_body"
            android:textColor="#212121"
            android:textSize="17sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/overlay_risk_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#616161"
            android:textSize="14sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/overlay_signal_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B71C1C"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/overlay_copilot_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:background="@drawable/overlay_card_background"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="italic"
            android:gravity="center"
            android:visibility="gone"/>

        <Button
            android:id="@+id/overlay_end_call_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/fraud_overlay_end_call"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/overlay_dismiss_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
